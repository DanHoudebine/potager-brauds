{
  "name": "potager-de-poche",
  "version": "2.0.0",
  "description": "Potager de Poche - Application de jardinage",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npm run build && npx cap sync && npx cap open android",
    "cap:run": "npm run build && npx cap sync && npx cap run android",
    "dist:android": "powershell -ExecutionPolicy Bypass -File scripts/dist-android.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.0.0",
    "@capacitor/geolocation": "^6.0.0",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/keyboard": "^6.0.4",
    "@capacitor/local-notifications": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@codetrix-studio/capacitor-google-auth": "3.4.0-rc.4",
    "cordova-plugin-purchase": "^13.17.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "typescript": "^5.4.0",
    "vite": "^6.4.3"
  }
}
