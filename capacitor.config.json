{
  "appId": "com.jardindepoche.app",
  "appName": "Jardin de Poche",
  "webDir": "dist",
  "backgroundColor": "#f9f6f0",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon",
      "iconColor": "#3a6b48",
      "sound": null
    },
    "Geolocation": {
      "permissions": ["coarse", "fine"]
    },
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#f9f6f0",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashFullScreen": false,
      "splashImmersive": false
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "LIGHT",
      "backgroundColor": "#f9f6f0"
    },
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    },
    "GoogleAuth": {
      "scopes": ["profile", "email"],
      "serverClientId": "813154716183-tgdujrasr772i91lc63fhlg4ef3t0c24.apps.googleusercontent.com",
      "forceCodeForRefreshToken": true
    }
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  }
}
