{
  "appId": "com.potagerdesbrauds.app",
  "appName": "Le Potager des Brauds",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon",
      "iconColor": "#3a6b48",
      "sound": null
    },
    "Geolocation": {
      "permissions": ["coarse", "fine"]
    }
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  }
}
